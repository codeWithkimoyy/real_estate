# EstateFlow Environment Configuration
# Copy this file to .env and update values for your environment

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate_db
DB_USER=root
DB_PASS=

# Application
APP_ENV=development
APP_URL=http://localhost/Activities/real_estate
APP_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING

# CORS - comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Session
SESSION_LIFETIME_HOURS=168
SESSION_MAX_PER_USER=5

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW=900
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW=60

# Bcrypt
BCRYPT_COST=12

# File Upload
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=../storage/uploads

# Email (for password reset / email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@estateflow.ph
SMTP_FROM_NAME=EstateFlow
SMTP_TIMEOUT=15

# Google Maps
GOOGLE_MAPS_API_KEY=

# Google Sign-In
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
